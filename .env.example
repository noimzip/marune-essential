# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Target Discord Guild (Server) ID
GUILD_ID=123456789012345678

# Target Category ID for disposable channels ("テキストチャンネル")
CATEGORY_ID=123456789012345678

# Comma-separated Forum Channel IDs to exclude from inactivity cleanup (Optional)
EXCLUDED_FORUM_IDS=

# Days of inactivity before sending forum topic deletion confirmation (Default: 21)
FORUM_INACTIVE_DAYS=21

# Health check HTTP server port (Default: 8080)
PORT=8080

# Timezone (Default: Asia/Tokyo)
TZ=Asia/Tokyo
